[Unit]
Description=Modbus Telemetry Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=/etc/default/modbus-telemetry
ExecStart=__UV_BIN__ run modbus-telemetry --config __PROJECT_DIR__/config.json
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
